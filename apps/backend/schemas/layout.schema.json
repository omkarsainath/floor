{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LayoutV1",
  "description": "Canonical floor-plan layout exchanged between backend, frontend, and shared fixtures.",
  "type": "object",
  "required": ["rooms", "walls"],
  "properties": {
    "metersPerUnit": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Real-world meters per one scene unit. Present only when the plan has been calibrated."
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "points"],
        "properties": {
          "id":     { "type": "string" },
          "name":   { "type": "string" },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end"],
        "properties": {
          "id":        { "type": "string" },
          "wall_type": { "type": "string", "enum": ["exterior", "interior", "half"] },
          "height":    { "type": "number", "exclusiveMinimum": 0 },
          "thickness": { "type": "number", "exclusiveMinimum": 0 },
          "material":  { "type": "string" },
          "start": {
            "type": "object", "required": ["x", "y"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          },
          "end": {
            "type": "object", "required": ["x", "y"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "class", "bbox"],
        "properties": {
          "id":         { "type": "string" },
          "class":      { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source":     { "type": "string", "enum": ["auto", "manual", "corrected", "ai"] },
          "bbox": {
            "type": "object", "required": ["x1", "y1", "x2", "y2"],
            "properties": {
              "x1": { "type": "number" }, "y1": { "type": "number" },
              "x2": { "type": "number" }, "y2": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
