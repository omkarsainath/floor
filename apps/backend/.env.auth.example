# Add these entries to apps/backend/.env; do not put them in frontend code.
APP_ORIGIN=http://localhost:5173
# Google Cloud Console -> OAuth client -> Web application -> Client ID
# Authorized JavaScript origin must exactly match APP_ORIGIN (including port).
GOOGLE_CLIENT_ID=
# Optional: absolute path to a writable private SQLite database.
# AUTH_DB_PATH=/private/path/accounts.sqlite3
