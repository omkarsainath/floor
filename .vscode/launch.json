{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/apps/backend/src/train_server.py",
      "cwd": "${workspaceFolder}/apps/backend/src",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "name": "Debug Auto Trainer",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/apps/backend/src/auto_trainer.py",
      "cwd": "${workspaceFolder}/apps/backend/src",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Attach to Running Server",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "justMyCode": false
    }
  ]
}
